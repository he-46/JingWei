config_version=5

[application]
config/name="精卫填海 · 衔石成洲"
config/description="A small 3D incremental adventure about Jingwei, a pangolin, and an ocean."
config/use_custom_user_dir=true
config/custom_user_dir_name="AzVGames/Jingwei"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1152
window/size/min_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.58, 0.76, 0.76, 1)

[physics]
common/physics_ticks_per_second=60
